#!/usr/bin/env bash
# Embed an SPDX SBOM into each collected npm package tarball using Syft.
# Parity with Python wheels: package/sboms/redhat.spdx.json (Fromager → redhat.spdx.json).
#
# Long-term tool: Syft (Anchore) — SPDX-JSON output, works for main + platform
# packages, no lockfile required, common in Konflux/RHTAS pipelines.
#
# Usage: generate-npm-sbom [artifact-dir]
# Default: ARTIFACT_ROOT (or ./artifact)
set -euo pipefail

_npm_sbom_identity_lib() {
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "${here}/lib/npm-sbom-identity.sh" ]]; then
        echo "${here}/lib/npm-sbom-identity.sh"
    elif [[ -f "${NPM_BUILDER_LIB:-/usr/local/lib/npm-builder}/npm-sbom-identity.sh" ]]; then
        echo "${NPM_BUILDER_LIB:-/usr/local/lib/npm-builder}/npm-sbom-identity.sh"
    else
        echo "npm-sbom-identity.sh not found" >&2
        return 1
    fi
}
# shellcheck source=lib/npm-sbom-identity.sh
source "$(_npm_sbom_identity_lib)"

ARTIFACT_DIR="${1:-${ARTIFACT_ROOT:-./artifact}}"
SBOM_REL="sboms/redhat.spdx.json"

# Avoid Syft calling out for update checks during factory builds.
export SYFT_CHECK_FOR_APP_UPDATE="${SYFT_CHECK_FOR_APP_UPDATE:-false}"

if [[ ! -d "${ARTIFACT_DIR}" ]]; then
    echo "[generate-npm-sbom] missing artifact dir: ${ARTIFACT_DIR}" >&2
    exit 1
fi

if ! command -v syft >/dev/null 2>&1; then
    echo "[generate-npm-sbom] ERROR: syft not found on PATH (expected in npm-builder image)" >&2
    exit 1
fi

tgz_files=()
while IFS= read -r f; do
    [[ -n "${f}" ]] && tgz_files+=("$f")
done < <(find "${ARTIFACT_DIR}" -type f -name '*.tgz' | LC_ALL=C sort)

if [[ ${#tgz_files[@]} -eq 0 ]]; then
    echo "[generate-npm-sbom] no .tgz files — nothing to embed"
    exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT

embedded=0
for tgz in "${tgz_files[@]}"; do
    [[ -f "${tgz}" ]] || continue

    rel="${tgz#${ARTIFACT_DIR}/}"
    rel="${rel#/}"
    extract_dir="${tmpdir}/extract-$((embedded))"
    mkdir -p "${extract_dir}"

    echo "[generate-npm-sbom] embedding SPDX SBOM into ${rel}"
    tar -xzf "${tgz}" -C "${extract_dir}"

    pkg_dir="${extract_dir}/package"
    pkg_json="${pkg_dir}/package.json"
    if [[ ! -f "${pkg_json}" ]]; then
        echo "[generate-npm-sbom] ERROR: ${rel} missing package/package.json" >&2
        exit 1
    fi

    name="$(jq -r '.name // empty' "${pkg_json}")"
    version="$(jq -r '.version // empty' "${pkg_json}")"
    if [[ -z "${name}" || -z "${version}" ]]; then
        echo "[generate-npm-sbom] ERROR: ${rel} package.json missing name/version" >&2
        exit 1
    fi

    mkdir -p "${pkg_dir}/sboms"
    sbom_path="${pkg_dir}/${SBOM_REL}"

    # Scan the package tree (npm metadata + files). SPDX 2.3 JSON.
    # Syft dir scans usually emit a DESCRIBES relationship to a path-only
    # root package (documentDescribes is often null) — enrich from package.json.
    syft scan "dir:${pkg_dir}" \
        -o "spdx-json=${sbom_path}" \
        --quiet

    [[ -s "${sbom_path}" ]] || {
        echo "[generate-npm-sbom] ERROR: syft did not write ${SBOM_REL} for ${rel}" >&2
        exit 1
    }

    purl="$(npm_sbom_purl "${name}" "${version}")"
    jq --arg name "${name}" --arg version "${version}" --arg purl "${purl}" '
        # Keep Syft purls that already identify this package (same coords,
        # optional ?qualifiers). Drop only conflicting purls; add bare $purl
        # when none remain.
        def same_npm_purl:
            . == $purl or startswith($purl + "?");
        def enrich:
            .name = $name
            | .versionInfo = $version
            | .externalRefs = (
                ((.externalRefs // [])
                  | map(select(
                      .referenceType != "purl"
                      or ((.referenceLocator // "") | same_npm_purl)
                    )))
                | if any(.[];
                    .referenceType == "purl"
                    and ((.referenceLocator // "") | same_npm_purl))
                  then .
                  else . + [{
                      referenceCategory: "PACKAGE-MANAGER",
                      referenceType: "purl",
                      referenceLocator: $purl
                    }]
                  end
              );
        # Prefer SPDX documentDescribes; else DOCUMENT DESCRIBES relationships
        # (Syft dir scans often leave documentDescribes null).
        def described_ids:
            (
              ((.documentDescribes // []) | map(select(type == "string")))
              + [
                  (.relationships // [])[]
                  | select(
                      (.spdxElementId // "") == "SPDXRef-DOCUMENT"
                      and (.relationshipType // "") == "DESCRIBES"
                      and ((.relatedSpdxElement // "") | type == "string")
                    )
                  | .relatedSpdxElement
                ]
            ) | unique;

        .name = ($name + "@" + $version)
        | if ((.packages // []) | length) == 0 then
            .packages = [{
                SPDXID: "SPDXRef-Package-npm-root",
                name: $name,
                versionInfo: $version,
                downloadLocation: "NOASSERTION",
                filesAnalyzed: false,
                externalRefs: [{
                    referenceCategory: "PACKAGE-MANAGER",
                    referenceType: "purl",
                    referenceLocator: $purl
                }]
            }]
            | .documentDescribes = ["SPDXRef-Package-npm-root"]
          else
            (described_ids) as $ids
            | if ($ids | length) == 0 then
                error("no documentDescribes/DESCRIBES package to enrich with npm identity")
              else
                .packages |= map(
                  (.SPDXID // "") as $sid
                  | if ($ids | index($sid)) != null
                    then enrich
                    else .
                    end
                )
                | if any(.packages[]?;
                    (.SPDXID // "") as $sid
                    | ($ids | index($sid)) != null
                      and .name == $name and .versionInfo == $version)
                  then .
                  else error("described package(s) missing from packages[] after enrich")
                  end
              end
          end
    ' "${sbom_path}" > "${sbom_path}.next" || {
        echo "[generate-npm-sbom] ERROR: cannot enrich SBOM for ${rel}" \
            "(expected documentDescribes or DOCUMENT DESCRIBES; refusing packages[0] fallback)" >&2
        rm -f "${sbom_path}.next"
        exit 1
    }
    mv "${sbom_path}.next" "${sbom_path}"

    # Fail closed: same SPDX-2 + identity predicate as verify-npm-sbom.
    if ! npm_sbom_identity_ok "${sbom_path}" "${name}" "${version}"; then
        echo "[generate-npm-sbom] ERROR: enriched SBOM missing SPDX-2 identity" \
            "${name}@${version} (${purl}) for ${rel}" >&2
        exit 1
    fi

    # Ensure package.json files includes the SBOM path (npm pack / publish allowlist).
    jq --arg sbom "${SBOM_REL}" '
        .files = ((.files // []) + [$sbom] | unique | sort)
    ' "${pkg_json}" > "${pkg_json}.next"
    mv "${pkg_json}.next" "${pkg_json}"

    # Repack in place (npm-style package/ root).
    pack_root="$(mktemp -d "${tmpdir}/pack.XXXXXX")"
    mkdir -p "${pack_root}/package"
    cp -a "${pkg_dir}/." "${pack_root}/package/"
    tar --create --gzip --file "${tgz}" --directory "${pack_root}" package

    echo "[generate-npm-sbom] embedded ${SBOM_REL} in ${rel} (${name}@${version})"
    embedded=$((embedded + 1))
done

echo "[generate-npm-sbom] embedded SPDX SBOM into ${embedded} tarball(s) via syft $(syft version 2>/dev/null | head -1 || true)"
